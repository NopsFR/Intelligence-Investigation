# NOPS / Cyber Intelligence — environment configuration
# Copy to .env.local for development. Only DATABASE_URL is required.
# Sources without credentials are shown as "Not configured" and are never
# called. Nothing is simulated.

# ─── Database ────────────────────────────────────────────────────────────────
# Runtime connection. On serverless hosts use a pooled URL (e.g. Supabase
# transaction pooler, port 6543, with ?pgbouncer=true).
DATABASE_URL="postgresql://user:password@host:5432/postgres"
# Direct (non-pooled) URL — only needed to run `npx prisma migrate deploy`.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ─── Operator access ─────────────────────────────────────────────────────────
# Long random token that unlocks deep investigations (which contact targets),
# deletions and IOC library edits. Without it those actions are disabled in
# production and open in local development.
NOPS_ADMIN_TOKEN=
# Optional dedicated HMAC key for session cookies (otherwise derived from the token).
NOPS_SESSION_SECRET=
# Set to 1 to require an operator session for every page and API route.
NOPS_PRIVATE=

# ─── Intelligence sources: key required ──────────────────────────────────────
# VirusTotal (free public API: 4 req/min, 500/day) — https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
# AbuseIPDB (free: 1,000 checks/day) — https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=
# abuse.ch Auth-Key — one key covers ThreatFox, URLhaus and MalwareBazaar
# (and upgrades YARAify). https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# Have I Been Pwned — required for per-account breach lookups (breachedaccount).
# The keyless breach catalogue (domain-wide) works without this.
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# ─── Intelligence sources: key optional (work without one) ───────────────────
# AlienVault OTX — higher limits, subscribed pulses
OTX_API_KEY=
# NVD — raises the limit from 5 to 50 requests per 30 s
NVD_API_KEY=
# GreyNoise Community — higher daily allowance
GREYNOISE_API_KEY=
# Web of Trust (WOT) domain/URL reputation — requires both a key and a user ID.
# https://www.mywot.com/developer
WOT_API_KEY=
WOT_USER_ID=
# Cert Spotter (SSLMate) — higher query allowance
CERTSPOTTER_API_KEY=

# Keys are read on the server only and are never sent to the browser.
