# NOPS / Cyber Intelligence — environment configuration
# Copy this file to .env.local and fill in only what you have.
# Every value here is optional except DATABASE_URL. Unconfigured providers
# are shown as "Not configured" in the API Observatory and are simply
# skipped during investigations — nothing is faked.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# A Postgres connection string. Any Postgres works (local, Supabase, Neon,
# RDS, ...). For serverless deployments (Vercel), use a connection-pooled
# URL — e.g. Supabase's "Transaction pooler" string on port 6543.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# ---------------------------------------------------------------------------
# Providers — free, no API key required
# ---------------------------------------------------------------------------
# RDAP, crt.sh, Cloudflare DNS-over-HTTPS, Google DNS-over-HTTPS, and CISA
# KEV all work with no credentials and show as "Connected" out of the box.
# NVD also works unauthenticated (see NVD_API_KEY below for the higher-quota
# option).

# NVD — https://nvd.nist.gov/developers/request-an-api-key
# Optional. Raises the public rate limit from 5 req/30s to 50 req/30s.
NVD_API_KEY=

# ---------------------------------------------------------------------------
# Providers — free tier, requires registration
# ---------------------------------------------------------------------------

# VirusTotal — https://www.virustotal.com/gui/join-us
# Free public API key. Rate limited to 4 requests/minute, 500/day.
VIRUSTOTAL_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/register
# Free tier: 1000 checks/day.
ABUSEIPDB_API_KEY=

# AlienVault OTX — https://otx.alienvault.com/api
# Free with account registration.
OTX_API_KEY=

# abuse.ch (ThreatFox, URLhaus, MalwareBazaar) — https://auth.abuse.ch/
# abuse.ch requires a free Auth-Key for all API access as of their 2025
# policy change. One key from your abuse.ch account works across all three
# of their platforms below.
THREATFOX_API_KEY=
URLHAUS_API_KEY=
MALWAREBAZAAR_API_KEY=

# ---------------------------------------------------------------------------
# Never commit a filled-in .env.local. Secrets stay server-side only —
# no provider key is ever sent to the browser.
# ---------------------------------------------------------------------------
