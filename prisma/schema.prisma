// NOPS / Cyber Intelligence — persistence schema (PostgreSQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ObservableType {
  IPV4
  IPV6
  DOMAIN
  URL
  MD5
  SHA1
  SHA256
  CVE
  ASN
  EMAIL
  CERT_SHA256
}

enum InvestigationStatus {
  PENDING
  RUNNING
  COMPLETE
  PARTIAL
  FAILED
}

enum ProviderStatus {
  SUCCESS
  PARTIAL
  EMPTY
  NOT_CONFIGURED
  RATE_LIMITED
  AUTH_FAILED
  TIMEOUT
  NETWORK_ERROR
  INVALID_RESPONSE
  UNAVAILABLE
  SKIPPED
}

enum InvestigationMode {
  QUICK
  DEEP
}

model Investigation {
  id                   String              @id @default(cuid())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  completedAt          DateTime?
  durationMs           Int?
  observable           String
  observableType       ObservableType
  normalizedObservable String
  mode                 InvestigationMode   @default(QUICK)
  status               InvestigationStatus @default(PENDING)
  summary              String?
  /// Ordered execution plan: [{ id, dependsOn }] — lets the UI show queued/running tasks.
  plan                 Json?
  metadata             Json?
  previousId           String?

  providerResults ProviderResult[]
  findings        Finding[]
  relationships   Relationship[]

  @@index([normalizedObservable, createdAt])
  @@index([observableType])
  @@index([createdAt])
  @@index([status])
}

model ProviderResult {
  id              String         @id @default(cuid())
  investigationId String
  investigation   Investigation  @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  provider        String
  status          ProviderStatus
  latencyMs       Int?
  startedAt       DateTime?
  retrievedAt     DateTime       @default(now())
  cached          Boolean        @default(false)
  httpStatus      Int?
  errorType       String?
  errorMessage    String?
  result          Json?
  raw             Json?
  diagnostics     Json?

  @@unique([investigationId, provider])
  @@index([provider, retrievedAt])
}

model Finding {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  rule            String
  severity        String
  category        String
  title           String
  description     String
  rationale       String?
  evidence        String
  evidenceData    Json?
  source          String
  observable      String?
  confidence      String?
  remediation     String?
  references      Json?
  observedAt      DateTime      @default(now())

  @@index([investigationId])
  @@index([severity, observedAt])
}

model Relationship {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  sourceType      String
  sourceValue     String
  targetType      String
  targetValue     String
  targetLabel     String?
  relationType    String
  provider        String
  evidence        String
  observedAt      DateTime      @default(now())

  @@index([investigationId])
}

model Observable {
  id        String         @id @default(cuid())
  value     String
  type      ObservableType
  firstSeen DateTime       @default(now())
  lastSeen  DateTime       @updatedAt
  tags      Json?

  @@unique([value, type])
}

model IocEntry {
  id                  String         @id @default(cuid())
  value               String
  type                ObservableType
  tags                Json?
  notes               String?
  source              String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  investigationRefIds Json?

  @@unique([value, type])
  @@index([updatedAt])
}

model ApiProviderHealth {
  id            String    @id @default(cuid())
  provider      String    @unique
  configured    Boolean   @default(false)
  lastCheckedAt DateTime?
  lastStatus    String?
  lastLatencyMs Int?
  lastError     String?
  lastErrorType String?
}

/// Every connection test is kept (bounded) so the Observatory can show latency history.
model ProviderCheck {
  id        String   @id @default(cuid())
  provider  String
  checkedAt DateTime @default(now())
  status    String
  latencyMs Int?
  errorType String?
  message   String?

  @@index([provider, checkedAt])
}

/// Cached provider responses, honouring per-provider TTLs.
model ProviderCache {
  id          String   @id @default(cuid())
  provider    String
  cacheKey    String
  status      String
  result      Json?
  raw         Json?
  diagnostics Json?
  httpStatus  Int?
  latencyMs   Int?
  retrievedAt DateTime
  expiresAt   DateTime

  @@unique([provider, cacheKey])
  @@index([expiresAt])
}

/// Fixed-window counters shared by every serverless instance (endpoint and provider quotas).
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

enum CaseStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum CaseItemKind {
  NOTE
  EVIDENCE
  CUSTODY
  EVENT
  LINK
}

/// A DFIR case: the container for an investigation's notes, evidence,
/// chain-of-custody log and timeline. Everything is written by the operator
/// (there is no multi-user auth), so "author" is a free-text label.
model Case {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  title       String
  description String?
  status      CaseStatus @default(OPEN)
  severity    String? // Severity, optional (a case may predate a scored finding)
  tags        Json? // string[]
  items       CaseItem[]

  @@index([status, updatedAt])
}

/// One entry in a case's record: a note, an evidence reference (hash, file,
/// observable, or investigation link), a chain-of-custody action, a
/// timeline event, or a link to another investigation/IOC.
model CaseItem {
  id        String       @id @default(cuid())
  caseId    String
  case      Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind      CaseItemKind
  createdAt DateTime     @default(now())
  author    String       @default("operator")
  /// Kind-specific payload: NOTE {text}; EVIDENCE {label,sha256?,sha1?,md5?,description?,source?};
  /// CUSTODY {action,handler,detail?}; EVENT {occurredAt,title,detail?,source?};
  /// LINK {refType:"investigation"|"ioc",refId,label?}.
  data      Json

  @@index([caseId, createdAt])
}
